<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Generates the C++ wrapper in Bindings/Cpp from the native ABI of MajSimai (Runtime/Unmanaged).
    See the "C++ wrapper" section of README.md for how to run it.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>14</LangVersion>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RootNamespace>MajSimai.CppGen</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MajSimai.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MajSimai.Tests" />
  </ItemGroup>

</Project>
