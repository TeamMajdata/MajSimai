<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net5.0;net6.0;net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <PackageId>Lingfeng-bbben.$(AssemblyName)</PackageId>
    <Authors>bbben;Lezi;Moying</Authors>
    <Company>Majdata</Company>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>True</PackageRequireLicenseAcceptance>
    <Version>3.0.1</Version>
    <LangVersion>14</LangVersion>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <IsTrimmable>True</IsTrimmable>
    <IsAotCompatible>True</IsAotCompatible>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <NativeLib>Shared</NativeLib>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
	  <GeneratePackageOnBuild>False</GeneratePackageOnBuild>
	  <TargetFrameworks>net7.0;net8.0;net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>
  <!--
    The native AOT compiler of .NET 7 does not run on macOS (NETSDK1204), and the restore of a publish covers every
    target framework, so a native AOT publish on macOS leaves net7.0 out.
  -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true' and $([MSBuild]::IsOSPlatform('OSX'))">
	  <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**;tools\**" />
    <None Remove="Tests\**;tools\**" />
    <EmbeddedResource Remove="Tests\**;tools\**" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MajSimai.Tests" />
    <InternalsVisibleTo Include="MajSimai.CppGen" />
  </ItemGroup>

</Project>
